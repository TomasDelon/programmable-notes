{
  "name": "programmable-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:tooling && npm run test:e2e",
    "prepare:runtime": "node scripts/runtime.mjs && node scripts/web-assets.mjs",
    "predev": "npm run prepare:runtime",
    "prebuild": "npm run prepare:runtime && npm run prepare:notices",
    "tauri": "tauri",
    "native:dev": "tauri dev",
    "native:build": "tauri build --no-bundle",
    "native:policy:test": "cargo test --manifest-path native-policy/Cargo.toml --locked",
    "native:test": "node scripts/native-webdriver.mjs",
    "native:resource:test": "cargo run --manifest-path native-policy/Cargo.toml --locked --example resource_gates",
    "native:stress:test": "node scripts/native-stress.mjs",
    "native:editor:test": "node scripts/native-editor.mjs",
    "native:documents:test": "cargo test --manifest-path native-documents/Cargo.toml --locked",
    "native:package": "tauri build --bundles deb --features custom-protocol -- --locked",
    "native:persistence:test": "node scripts/native-persistence.mjs",
    "native:wry:verify": "node scripts/verify-wry.mjs",
    "native:package:verify": "node scripts/verify-linux-package.mjs",
    "native:lifecycle:test": "node scripts/native-lifecycle.mjs",
    "pretest": "npm run prepare:runtime",
    "pretest:watch": "npm run prepare:runtime",
    "native:session:test": "node scripts/native-session-status.mjs",
    "native:renderer:test": "node scripts/native-renderer-failure.mjs",
    "native:preview-renderer:test": "node scripts/native-preview-renderer.mjs",
    "prepare:notices": "node scripts/third-party-notices.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "native:save-enospc:test": "node scripts/native-save-enospc.mjs",
    "pretest:tooling": "npm run prepare:runtime",
    "postbuild": "node scripts/web-offline.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@tauri-apps/api": "2.12.5",
    "clsx": "2.1.1",
    "esbuild-wasm": "0.28.2",
    "katex": "0.19.1",
    "lucide-react": "1.77.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-inputrules": "1.7.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.14.0",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-list": "1.6.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
