15a4237f04f98e25e745aac7dd5da1cdb57a1844df0c7535fa32ae073b9572a4  SessionHostGlib-webkitgtk-2.52.6.cpp

The engine sandbox explicitly shares networking when that endpoint is set:
https://github.com/WebKit/WebKit/blob/webkitgtk-2.52.6/Source/WebKit/UIProcess/Launcher/glib/BubblewrapLauncher.cpp#L81-L90
  const char* env = g_getenv("WEBKIT_INSPECTOR_SERVER");
  enabled = env && *env;
https://github.com/WebKit/WebKit/blob/webkitgtk-2.52.6/Source/WebKit/UIProcess/Launcher/glib/BubblewrapLauncher.cpp#L714-L741
  if (remoteInspectorEnabled())
      return false;
https://github.com/WebKit/WebKit/blob/webkitgtk-2.52.6/Source/WebKit/UIProcess/Launcher/glib/BubblewrapLauncher.cpp#L877-L878
  if (shouldUnshareNetwork(launchOptions.processType, argv))
